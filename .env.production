# Production build overrides for the frontend (Vite reads this automatically
# for `vite build`, which runs in "production" mode by default).
#
# The deployed instance serves the built frontend from the same FastAPI
# process that answers the API and WebSocket (see backend/app/main.py's
# static mount), so these are deliberately empty: an empty base URL makes
# every fetch() and `new WebSocket()` call same-origin-relative, which the
# browser resolves against whatever host the page was actually loaded from
# (and translates ws/wss correctly), rather than a hardcoded URL baked into
# the bundle at build time.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
