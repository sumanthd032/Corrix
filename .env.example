# Corrix environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Inference backends (Step 1, Step 4) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Regulatory Intelligence substrate (Step 1, Step 5) ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- Emergency Response Orchestrator (Step 9) ---
# Set exactly one of these, matching the channel decided before Step 9.
ERO_SLACK_WEBHOOK_URL=
ERO_DISCORD_WEBHOOK_URL=
ERO_SMTP_HOST=
ERO_SMTP_PORT=587
ERO_SMTP_USERNAME=
ERO_SMTP_PASSWORD=
ERO_ALERT_FROM_EMAIL=
ERO_ALERT_TO_EMAIL=

# --- Backend runtime ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Cross-origin frontend (only when the frontend is hosted separately,
#     e.g. Vercel, and the backend elsewhere, e.g. AWS + Cloudflare Tunnel).
#     Not needed for the single-service (Render/Docker) deployment. ---
# The frontend origin(s) allowed to call this API. Comma-separate more than one.
CORRIX_EXTRA_CORS_ORIGIN=
# Optional regex for dynamic origins such as Vercel preview deployments.
# Example: https://.*\.vercel\.app
CORRIX_CORS_ORIGIN_REGEX=

# --- LLM call tuning (Step 9 hardening) ---
# Optional. Defaults match the live Council's existing behavior; lower
# these for a batch script (e.g. run_memory_loop_experiment.py) running
# many Council convenings back to back on a constrained free-tier key.
LLM_MAX_CONCURRENT_REQUESTS=8
GROQ_MAX_CONSECUTIVE_429S=2
GROQ_RETRY_BACKOFF_CAP_SECONDS=10.0
MEMORY_LOOP_SCENARIO_DELAY_SECONDS=0

# --- Frontend (Vite reads VITE_-prefixed vars from frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
